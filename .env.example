# niblit-ui environment (copy to .env.local)

# Niblit runtime API (server.py / app.py) — started by Niblit before UI launch
VITE_NIBLIT_API_URL=http://127.0.0.1:8080

# niblit-cloud-server inference API (optional)
VITE_NIBLIT_CLOUD_URL=http://127.0.0.1:8000

# Set to 1 to use in-browser demo connector (no backend required)
# VITE_NIBLIT_USE_DEMO=0
